# SEC requires automated clients to identify themselves with a contact email
# and to stay under 10 requests per second.
# https://www.sec.gov/os/webmaster-faq#developers
#
# Copy this file to .env. It is read by the local scripts (dene.py, dogrula.py)
# and by Docker via --env-file. The MCP server itself takes its environment
# from whatever launches it (Claude Desktop config, Docker, shell).
SEC_USER_AGENT="Your Name you@example.com"

# Requests per second sent to SEC. Defaults to 8, below SEC's published ceiling
# of 10. Raising it risks a block, so leave it alone unless you know why.
#SEC_RATE_LIMIT_PER_SEC=8

# Point-in-time cutoff for the whole process, as YYYY-MM-DD. Every tool that
# selects by recency will ignore anything SEC received after this date, and say
# so in as_of_applied. Unset means today. One tool cannot honour it and refuses
# the call instead of pretending - see the README.
#SEC_AS_OF=2025-05-16
